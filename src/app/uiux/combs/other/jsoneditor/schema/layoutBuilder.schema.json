        },
        "spacer": {
          "type": "string"
        },
        "classes": {
          "type": "string"
        },
        "fullWidth": {
          "type": "boolean"
        },
        "style": {
          "type": "object"
        },
        "horizontal": {
          "$ref": "#/definitions/Horizontal"
        },
        "vertical": {
          "$ref": "#/definitions/Vertical"
        },
        "alignItems": {
          "$ref": "#/definitions/AlignItems"
        },
        "wrapperClass": {
          "type": "string"
        },
        "bgClasses": {
          "type": "string"
        },
        "overlay": {
          "type": "string"
        },
        "gap": {
          "$ref": "#/definitions/Gap"
        },
        "bg": {
          "$ref": "#/definitions/Bg"
        },
        "animate": {
          "$ref": "#/definitions/Animate"
