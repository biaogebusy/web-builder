        },
        "horizontal": {
          "$ref": "#/definitions/Horizontal"
        },
        "vertical": {
          "$ref": "#/definitions/Vertical"
        },
        "alignItems": {
          "$ref": "#/definitions/AlignItems"
        },
        "gap": {
          "$ref": "#/definitions/Gap"
        },
        "bg": {
          "$ref": "#/definitions/Bg"
        },
        "animate": {
          "$ref": "#/definitions/Animate"
        },
