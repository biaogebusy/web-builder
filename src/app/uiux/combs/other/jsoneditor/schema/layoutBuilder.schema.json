        },
        "md": {
          "type": ["number", "string"]
        },
        "lg": {
          "type": ["number", "string"]
        }
      },
      "required": [],
      "title": "Row"
    },
    "Style": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "aspectRatio": {
          "type": "string"
        },
        "objectFit": {
          "type": "string"
        },
        "opacity": {
          "type": "number"
        },
        "borderRadius": {
          "type": "string"
        },
        "boxShadow": {
          "type": "string"
        }
      },
      "required": [],
      "title": "Style"
    }
  }
}
