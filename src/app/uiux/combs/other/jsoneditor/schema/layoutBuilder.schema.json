      "required": ["elements", "row"],
      "title": "Element"
    },
    "Animate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "from": {
          "type": "object"
        },
        "trigger": {
          "type": "object"
        }
      },
      "title": "Animate"
    },
    "Bg": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
