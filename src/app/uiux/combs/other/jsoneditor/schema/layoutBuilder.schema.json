          "type": "string"
        },
        "hostClasses": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "style": {
          "$ref": "#/definitions/Style"
        },
        "animate": {
          "$ref": "#/definitions/Animate"
        }
      },
      "required": ["src"],
      "title": "Img"
