    },
    "Vertical": {
      "type": "string",
      "enum": ["start", "end", "center", "baseline", "stretch"],
      "title": "Vertical"
    },
    "AlignItems": {
      "type": "string",
      "enum": ["start", "end", "center", "baseline", "stretch"],
      "title": "AlignItems"
    },
    "Element": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "classes": {
          "type": "string"
        },
        "blockClasses": {
          "type": "string"
        },
        "style": {
          "$ref": "#/definitions/Style"
        },
        "row": {
          "$ref": "#/definitions/Row"
        },
        "direction": {
          "type": "string"
        },
        "wrap": {
          "type": "string"
        },
        "aos": {
