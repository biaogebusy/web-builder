{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$ref": "#/definitions/Core",
  "definitions": {
    "Core": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "defaultTheme": {
          "type": "string"
        },
        "theme": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Theme"
          }
        },
        "login": {
          "$ref": "#/definitions/Login"
        },
        "user": {
          "$ref": "#/definitions/User"
        },
        "defaultAvatar": {
          "type": "string"
        },
        "amap": {
          "$ref": "#/definitions/Amap"
        },
        "loading": {
          "type": "boolean"
        },
        "loadingBar": {
          "type": "boolean"
        },
        "guard": {
          "$ref": "#/definitions/Guard"
        },
        "article": {
          "$ref": "#/definitions/Article"
        },
        "clarity": {
          "$ref": "#/definitions/Clarity"
        },
        "analytics": {
          "$ref": "#/definitions/Analytics"
        },
        "animate": {
          "type": "boolean"
        },
        "github": {
          "$ref": "#/definitions/Github"
        },
        "builder": {
          "$ref": "#/definitions/Builder"
        }
      },
      "required": [
        "amap",
        "animate",
        "builder",
        "defaultAvatar",
        "defaultTheme",
        "guard",
        "loading",
        "loadingBar",
        "login",
        "theme",
        "user"
      ],
      "title": "Core"
    },
    "Amap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "city": {
          "type": "string"
        },
        "zoom": {
          "type": "integer"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "mapStyle": {
          "$ref": "#/definitions/MapStyle"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["center", "city", "features", "key", "mapStyle", "plugins", "version", "zoom"],
      "title": "Amap"
    },
    "MapStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light": {
          "type": "string"
        },
        "dark": {
          "type": "string"
        }
      },
      "required": ["dark", "light"],
      "title": "MapStyle"
    },
    "Builder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "guard": {
          "type": "boolean"
        },
        "params": {
          "$ref": "#/definitions/Params"
        }
      },
      "required": ["enable", "guard", "params"],
      "title": "Builder"
    },
    "Params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reqRoles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["reqRoles"],
      "title": "Params"
    },
    "Clarity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": ["id"],
      "title": "Clarity"
    },
    "Article": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comment": {
          "$ref": "#/definitions/Comment"
        }
      },
      "required": ["comment"],
      "title": "Article"
    },
    "Comment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "boolean"
        }
      },
      "required": ["enable"],
      "title": "Comment"
    },
    "Analytics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ga": {
          "$ref": "#/definitions/Ga"
        }
      },
      "required": ["ga"],
      "title": "Analytics"
    },
    "Ga": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": ["id"],
      "title": "Ga"
    },
    "Github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "token": {
          "type": "string"
        }
      },
      "required": ["enable", "owner", "repo", "token"],
      "title": "Github"
    },
    "Guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authGuard": {
          "type": "boolean"
        },
        "checkUserState": {
          "type": "boolean"
        }
      },
      "required": ["authGuard", "checkUserState"],
      "title": "Guard"
    },
    "Login": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loginRedirect": {
          "type": "string"
        },
        "left": {
          "type": "object"
        },
        "phoneLogin": {
          "$ref": "#/definitions/PhoneLogin"
        },
        "oauthLogin": {
          "$ref": "#/definitions/OauthLogin"
        },
        "socialLogin": {
          "$ref": "#/definitions/SocialLogin"
        }
      },
      "required": ["left", "loginRedirect", "oauthLogin", "phoneLogin"],
      "title": "Login"
    },
    "SocialLogin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SocialLoginProvider"
          }
        }
      },
      "required": ["enable", "label", "providers"],
      "title": "SocialLogin"
    },
    "SocialLoginProvider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "svgIcon": {
          "type": "string"
        },
        "idp": {
          "type": "string"
        }
      },
      "required": ["enable", "idp", "label", "svgIcon"],
      "title": "SocialLoginProvider"
    },
    "Left": {
      "type": "object"
    },
    "Img": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "classes": {
          "type": "string"
        }
      },
      "required": ["classes", "src"],
      "title": "Img"
    },
    "Config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typeSpeed": {
          "type": "integer"
        }
      },
      "required": ["typeSpeed"],
      "title": "Config"
    },
    "String": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "required": ["label"],
      "title": "String"
    },
    "PhoneLogin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "tabLabel": {
          "type": "string"
        },
        "leftTime": {
          "type": "integer"
        },
        "submitLabel": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "delayMessage": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "code": {
          "$ref": "#/definitions/SmsCode"
        }
      },
      "required": ["enable", "error", "leftTime", "submitLabel", "tabLabel"],
      "title": "PhoneLogin"
    },
    "SmsCode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "sendLabel": {
          "type": "string"
        }
      },
      "required": ["label", "sendLabel"],
      "title": "SmsCode"
    },
    "OauthLogin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "submitLabel": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        }
      },
      "required": ["enable", "submitLabel"],
      "title": "OauthLogin"
    },
    "Theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "svgIcon": {
          "type": "string"
        }
      },
      "required": ["name", "style"],
      "title": "Theme"
    },
    "User": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "banner": {
          "type": "string"
        }
      },
      "required": ["banner"],
      "title": "User"
    }
  }
}
